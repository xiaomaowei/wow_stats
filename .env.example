# Blizzard API Credentials
# Get these from https://develop.battle.net/access/
BLIZZARD_CLIENT_ID=your_client_id_here
BLIZZARD_CLIENT_SECRET=your_client_secret_here

# Your WoW Region
# Options: us, eu, kr, tw
# Note: When REGION=tw and LOCALE=zh_TW, game data (character stats, items, spells, realm names)
# is returned by the Blizzard API in Traditional Chinese.
REGION=eu

# Blizzard API Locale
# Options: en_US, es_MX, pt_BR, en_GB, es_ES, fr_FR, ru_RU, de_DE, it_IT, pt_PT, ko_KR, zh_TW, zh_CN
# Note: LOCALE controls the language of Blizzard API game data.
# When LOCALE=zh_TW, the UI default also defaults to Traditional Chinese (zh-TW), unless overridden by UI_LOCALE.
LOCALE=en_GB

# UI Language (Optional default UI locale)
# Options: en, zh-TW (or en_US, zh_TW)
# Defaults:
# - If UI_LOCALE is set, it explicitly sets the default UI language (en or zh-TW).
# - If UI_LOCALE is not set, defaults to zh-TW when LOCALE=zh_TW, otherwise English (en).
# Users can also change their preferred UI language dynamically on any page using the top-left language switcher.
# UI_LOCALE=zh-TW

# Server Port
PORT=8081

# Optional: PostgreSQL connection string for history tracking (gold & item level progression)
# If not set, the app runs normally with no database — localStorage state is unaffected.
# The database and schema will be created automatically on first startup.
# DATABASE_URL=postgres://user:password@host:5432/wow_stats
